{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodeDeliverable",
  "type": "object",
  "required": [
    "module_name",
    "source_files",
    "test_files",
    "dependencies",
    "test_coverage_pct",
    "build_status"
  ],
  "properties": {
    "module_name": { "type": "string" },
    "source_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "description", "code"],
        "properties": {
          "path": { "type": "string" },
          "description": { "type": "string" },
          "code": { "type": "string" }
        }
      }
    },
    "test_files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "test_count", "code"],
        "properties": {
          "path": { "type": "string" },
          "test_count": { "type": "integer" },
          "code": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_coverage_pct": { "type": "number", "minimum": 0, "maximum": 100 },
    "build_status": { "type": "string", "enum": ["SUCCESS", "FAILED"] }
  }
}
